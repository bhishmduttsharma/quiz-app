NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JSON_LIMIT=2mb

# Use MongoDB Atlas or a local MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/quiz-app

# Replace this with a long random value before deployment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Seeded admin account for project demonstration.
ADMIN_EMAIL=admin@quiz.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Quiz Admin

# Optional code that allows creating additional admin accounts from signup.
ADMIN_INVITE_CODE=AKHILESH
